[Unit]
Description=CamillaDSP (Omarchy plugin)
Documentation=https://github.com/HEnquist/camilladsp
After=omarchy-camilladsp-sink.service
BindsTo=omarchy-camilladsp-sink.service
PartOf=pipewire.service

[Service]
Type=simple
# The statefile keeps CamillaDSP's own volume and mute across restarts. The config
# is regenerated by camilladsp-omarchy from the selected preset.
#
# No --port: CamillaDSP's websocket has no authentication, and every local
# account could reach it on loopback and load a config that writes files as
# this user. Everything here is done by rewriting the config and reloading.
ExecStart=@CAMILLADSP@ --statefile @STATE_DIR@/statefile.yml @STATE_DIR@/active.yml
# SIGHUP makes CamillaDSP reread the config, which is how presets switch.
ExecReload=/bin/kill -HUP $MAINPID
# Tell the bar widget, so a crash or an outside systemctl call shows up at once.
ExecStartPost=-/usr/bin/omarchy-shell -q c622.camilladsp refresh
ExecStopPost=-/usr/bin/omarchy-shell -q c622.camilladsp refresh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
