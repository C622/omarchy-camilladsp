#!/usr/bin/python3 -I

# Send commands to CamillaDSP's websocket server and print the replies as one
# JSON object keyed by command name.
#
#   camilla-ws 1234 '"GetState"' '"GetProcessingLoad"' '{"SetVolume": -3}'
#
# A minimal RFC 6455 client on the standard library, so the plugin needs no
# websocket package. CamillaDSP only listens on 127.0.0.1 here, sends small
# unfragmented text frames, and answers each request in order.

import base64
import json
import os
import socket
import struct
import sys

TIMEOUT = 1.5


def recv_exact(sock, n):
    data = b""
    while len(data) < n:
        chunk = sock.recv(n - len(data))
        if not chunk:
            raise ConnectionError("connection closed")
        data += chunk
    return data


def handshake(sock, host, port):
    key = base64.b64encode(os.urandom(16)).decode()
    request = (
        f"GET / HTTP/1.1\r\n"
        f"Host: {host}:{port}\r\n"
        f"Upgrade: websocket\r\n"
        f"Connection: Upgrade\r\n"
        f"Sec-WebSocket-Key: {key}\r\n"
        f"Sec-WebSocket-Version: 13\r\n\r\n"
    )
    sock.sendall(request.encode())
    response = b""
    while b"\r\n\r\n" not in response:
        chunk = sock.recv(1024)
        if not chunk:
            raise ConnectionError("handshake closed")
        response += chunk
    if not response.startswith(b"HTTP/1.1 101"):
        raise ConnectionError("handshake refused")


def send_frame(sock, opcode, payload):
    header = bytearray([0x80 | opcode])
    length = len(payload)
    if length < 126:
        header.append(0x80 | length)
    elif length < 65536:
        header.append(0x80 | 126)
        header += struct.pack("!H", length)
    else:
        header.append(0x80 | 127)
        header += struct.pack("!Q", length)
    mask = os.urandom(4)
    masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
    sock.sendall(bytes(header) + mask + masked)


def send_text(sock, text):
    send_frame(sock, 0x1, text.encode())


# Close politely: a dropped connection makes CamillaDSP log a warning for every
# status read, which would fill the journal while the panel is open.
def close(sock):
    try:
        send_frame(sock, 0x8, struct.pack("!H", 1000))
        while True:
            recv_text(sock)
    except (OSError, ConnectionError):
        pass


def recv_text(sock):
    message = b""
    while True:
        first, second = recv_exact(sock, 2)
        opcode = first & 0x0F
        length = second & 0x7F
        if length == 126:
            length = struct.unpack("!H", recv_exact(sock, 2))[0]
        elif length == 127:
            length = struct.unpack("!Q", recv_exact(sock, 8))[0]
        mask = recv_exact(sock, 4) if second & 0x80 else None
        payload = recv_exact(sock, length)
        if mask:
            payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        if opcode == 0x8:
            raise ConnectionError("server closed")
        if opcode == 0x9:
            continue
        message += payload
        if first & 0x80:
            return message.decode()


def main():
    if len(sys.argv) < 3:
        print("usage: camilla-ws <port> <command-json>...", file=sys.stderr)
        return 2

    port = int(sys.argv[1])
    replies = {}
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=TIMEOUT) as sock:
            handshake(sock, "127.0.0.1", port)
            for command in sys.argv[2:]:
                send_text(sock, command)
                replies.update(json.loads(recv_text(sock)))
            close(sock)
    except (OSError, ConnectionError, ValueError) as error:
        print(f"camilla-ws: {error}", file=sys.stderr)
        print(json.dumps(replies))
        return 1

    print(json.dumps(replies))
    return 0


if __name__ == "__main__":
    sys.exit(main())
