#!/usr/bin/python3 -I

"""Tell the Loudness stage of a calibrated preset how loud the music plays.

  loudness-tracker <state-dir>

Hearing loses bass and treble as the level drops, so quiet music sounds thin.
The Loudness stage puts that back, but only knows how much to when it is told
the listening level, and with Omarchy that level is the real output's volume,
set after CamillaDSP. This watches that volume and hands it to
camilladsp-omarchy, which fills the gains into the config and reloads it;
CamillaDSP applies changed filter gains without interrupting the sound.

It never talks to CamillaDSP itself: CamillaDSP runs without its websocket,
which has no authentication and would be open to every local account.

It reacts to PulseAudio events instead of polling, and re-reads the output
CamillaDSP plays to on every change, so switching outputs is followed too.

When the volume is set further on, on an amplifier, the output stays at full
and there is nothing to follow. The Loudness strength then says how much
quieter than the output the music is taken to play (LOUDNESS_LEVELS in
calibration_dsp.py), read from calibration-options.json.
"""

import json
import os
import re
import select
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
CONTROL = os.path.join(HERE, "..", "bin", "camilladsp-omarchy")
LEVELS = {"volume": 0.0, "some": -12.0, "full": -25.0}  # LOUDNESS_LEVELS in calibration_dsp.py


def target(state_dir):
    try:
        with open(os.path.join(state_dir, "target")) as f:
            return f.read().strip()
    except OSError:
        return ""


def level_offset(state_dir):
    try:
        with open(os.path.join(state_dir, "calibration-options.json")) as f:
            return LEVELS.get(json.load(f).get("loudness_level", "volume"), 0.0)
    except (OSError, ValueError):
        return 0.0


def volume_db(sink):
    """The sink's volume in dB, the loudest channel; -100 when muted."""
    mute = subprocess.run(["pactl", "get-sink-mute", sink], capture_output=True, text=True, timeout=5).stdout
    if "yes" in mute:
        return -100.0
    out = subprocess.run(["pactl", "get-sink-volume", sink], capture_output=True, text=True, timeout=5).stdout
    values = [-100.0 if v == "-inf" else float(v) for v in re.findall(r"(-inf|-?\d+(?:\.\d+)?) dB", out)]
    return max(values) if values else None


def send(level):
    """Hand the listening level on, rounded to the half dB nobody can hear past."""
    result = subprocess.run([CONTROL, "loudness", "%.1f" % (round(level * 2) / 2)],
                            capture_output=True, text=True, timeout=30)
    return result.returncode == 0


def main():
    state_dir = sys.argv[1]
    last = None
    while True:
        events = subprocess.Popen(["pactl", "subscribe"], stdout=subprocess.PIPE, text=True)
        pending = True
        while events.poll() is None:
            if pending:
                sink = target(state_dir)
                db = volume_db(sink) if sink else None
                if db is not None:
                    db = max(db + level_offset(state_dir), -100.0)
                # Keep trying while the control command fails, as it can while
                # CamillaDSP is still starting.
                if db is not None and db != last:
                    last = db if send(db) else None
                pending = last is None and db is not None
            ready, _, _ = select.select([events.stdout], [], [], 1.0 if pending else None)
            if ready:
                line = events.stdout.readline()
                if not line:
                    break
                if "on sink #" in line or "on server" in line:
                    pending = True
                    # A volume drag is a burst of events; read it as one, and
                    # wait for it to settle so a drag is a few reloads, not dozens.
                    while select.select([events.stdout], [], [], 0.15)[0]:
                        if not events.stdout.readline():
                            break
        events.kill()
        # The audio server went away; wait for it to come back.
        last = None
        time.sleep(2)


if __name__ == "__main__":
    main()
